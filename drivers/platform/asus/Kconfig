# Asus configuration options

config MACH_ASUS
	bool "Asus device"
	help
	  Support for Asus products

config ASUS_HWID
	tristate "ASUS hardware id driver"
	depends on MACH_ASUS
	help
	 Say yes here to support the ASUS hardware id driver. This driver 
         provides export functions about the hardware id for other module.

config MACH_ASUS_LAHAINA
	bool "Asus LAHAINA"
	depends on ARCH_LAHAINA
	select MACH_ASUS
	help
	  Support for LAHAINA Asus variants

menu "Asus board selection"

config MACH_ASUS_ZS673KS
	bool "ZS673KS board"
	select MACH_ASUS_KONA
	help
	  Support for Anakin (Rog5)

config ASUS_PICASSO_QTI_EMBEDDED
	bool "PICASSO bool config"
	help
	  Support for Picasso on GKI driver

config ASUS_PICASSO_GKI
	bool "PICASSO bool config"
	help
	  Picasso module for GKI

config MACH_ASUS_PICASSO
	bool "PICASSO board"
	select MACH_ASUS
	select ASUS_PICASSO_QTI_EMBEDDED
	help
	  Support for Picasso

config MACH_ASUS_SAKE
	bool "SAKE board"
	select MACH_ASUS
	help
	  Support for Sake

config MACH_ASUS_VODKA
	bool "VODKA board"
	select MACH_ASUS
	help
	  Support for Vodka

endmenu

