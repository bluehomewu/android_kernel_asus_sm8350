config ASUS_ASH
	bool "ASUS Picasso ambient light and proximity sensors"
	depends on MACH_ASUS_PICASSO && I2C && INPUT && GPIOLIB && REGULATOR
	default y
	help
	  Build the single VCNL36866 sensor pipeline used by Picasso.
	  This also supplies proximityStatus() to the ROG touchscreen.

config SENSORS_ICM206XX
	tristate "ICM206XX 6-axis gyroscope and acceleromater combo"
	depends on INPUT && SPI
	help
	  Say Y here if you want to support InvenSense ICM206XX
	  connected via an I2C bus.

	  To compile this driver as a module, choose M here: the
	  module will be called ICM206XX.

config ASUS_PICASSO_ICM206XX
	bool "ASUS Picasso secondary accelerometer and gyroscope"
	depends on MACH_ASUS_PICASSO && INPUT && SPI && I2C
	depends on GPIOLIB && REGULATOR && PM && PROC_FS
	default y
	help
	  Build the ICM20690 secondary IMU interfaces used by the sensor HAL.
	  This driver registers both SPI and I2C drivers and must be built in.
