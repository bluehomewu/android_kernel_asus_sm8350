/*    ====================================
 *    overlay for lahaina-usb.dtsi - start
 *    ====================================
 */
&redriver {
	status = "disable";
};

&usb_qmp_dp_phy {
	pinctrl-names = "default";
};

&usb0 {
	dwc3@a600000 {
		maximum-speed = "super-speed-plus";
	};
};

