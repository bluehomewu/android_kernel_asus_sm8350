/*    ====================================
 *    overlay for lahaina-pmic-overlay.dtsi - start
 *    ====================================
 */


&L5I {
	regulator-max-microvolt = <3400000>;
};

&cam_cci0 {
	qcom,cam-sensor0 {
		cam_vaf-supply = <&pm8008i_l5>; //<&cam_vm_3p1_en>;          //CAM0_VM_PWR_EN OR CAM0_VM_3P1: <&pm8008i_l5>
		rgltr-min-voltage = <2900000 2900000 1800000 1800000 1104000 3100000 0>;
		rgltr-max-voltage = <2900000 2900000 1800000 1800000 1104000 3100000 0>;
	};

	qcom,cam-sensor4 {
		cam_vaf-supply = <&pm8008i_l5>; //<&cam_vm_3p1_en>;          //CAM0_VM_PWR_EN OR CAM0_VM_3P1: <&pm8008i_l5>
		rgltr-min-voltage = <2900000 2900000 1800000 1800000 1104000 3100000 0>;
		rgltr-max-voltage = <2900000 2900000 1800000 1800000 1104000 3100000 0>;
	};
};

&cam_cci1 {
	qcom,cam-sensor3 {
		cam_v_custom2-supply = <&pm8008i_l3>;   //<&cam_8m_vm_2p8_en>;          //CAM2_VM_2P8 //PM8008_1_LDO3_2P8
	};
};

/*    ====================================
 *    overlay for lahaina-pmic-overlay.dtsi - end
 *    ====================================
 */


