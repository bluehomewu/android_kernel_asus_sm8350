/dts-v1/;
/plugin/;

#include "PICASSO-ER2-overlay.dts"


/ {
	model = "Qualcomm Technologies, Inc. ASUS PICASSO PR1";
	compatible = "qcom,lahaina-mtp", "qcom,lahaina", "qcom,mtp";
	qcom,board-id = <85 0>;
};

